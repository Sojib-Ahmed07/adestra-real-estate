# ==============================================================================
# NEON POSTGRESQL DATABASE CONFIGURATION (Drizzle ORM)
# ==============================================================================
# Obtain this connection string from your Neon Console (https://console.neon.tech)
# Select your project -> "Connection Details" -> select "Connection string" or "Pooled connection"
DATABASE_URL="postgresql://neondb_owner:your_password_here@ep-your-endpoint-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Optional: Direct/unpooled connection URL for migrations or heavy DDL operations
# DIRECT_URL="postgresql://neondb_owner:your_password_here@ep-your-endpoint.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ==============================================================================
# APPLICATION SETTINGS
# ==============================================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="VALOIS Estates & Mansions"

# ==============================================================================
# ADMIN / AUTHENTICATION (For /admin dashboard portal)
# ==============================================================================
# Generate a secret with: openssl rand -base64 32
AUTH_SECRET="your_random_auth_secret_key_here"
ADMIN_EMAIL="admin@valoisestates.com"
ADMIN_PASSWORD="your_secure_admin_password_here"
